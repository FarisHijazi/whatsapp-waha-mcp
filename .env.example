# WAHA MCP Server Configuration

# WAHA API Base URL (required)
# This should point to your running WAHA instance
WAHA_BASE_URL=https://your-waha-server.com

# WAHA API Key (optional, if authentication is required)
WAHA_API_KEY=your-api-key-here

# SSL Verification (optional, default: true)
# Set to "false" to disable SSL verification for self-signed certificates
WAHA_VERIFY_SSL=true

# Test Chat ID (optional, for test script)
# Used by scripts/test_waha.py to send test messages
# Format: 1234567890@c.us (contact) or 1234567890@g.us (group)
WAHA_CHAT_ID=
